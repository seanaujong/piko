{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["chrome", "node"],
    "noEmit": true
  },
  "include": ["src", "e2e", "bench", "vitest.config.ts", "vitest.bench.config.ts", "vitest.setup.ts"]
}

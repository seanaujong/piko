{
  "manifest_version": 3,
  "name": "Piko",
  "version": "0.1.0",
  "description": "Drag a link to preview its content in place, instead of opening a tab.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Piko \u2014 clip this page"
  },
  "options_ui": {
    "page": "onboarding.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}

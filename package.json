{
  "name": "piko",
  "version": "0.1.0",
  "private": true,
  "description": "Piko lets you preview links by dragging them. Read through websites without losing context!",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && git config pull.rebase true",
    "bench": "vitest run --config vitest.bench.config.ts",
    "build": "node esbuild.config.mjs",
    "check": "npm run typecheck && npm run test",
    "icons": "node scripts/render-icons.mjs",
    "icons:sheet": "node scripts/icon-sheet.mjs",
    "icons:store": "node scripts/store-icon.mjs",
    "package": "node scripts/package.mjs",
    "release-bump": "node scripts/release-bump.mjs",
    "shots": "vitest run --config vitest.shots.config.ts shots/capture.shots.ts",
    "shots:store": "vitest run --config vitest.shots.config.ts shots/store.shots.ts",
    "test": "vitest run",
    "test:browser": "vitest run --project geometry --project e2e",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.2.0",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^26.1.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
